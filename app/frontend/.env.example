VITE_API_URL=/api/v1
# Never put a secret map-provider key into VITE_* variables.
# Optional: URL шаблона растровых тайлов вида https://.../{z}/{x}/{y}.png
VITE_MAP_TILE_URL=
# Optional: attribution text required by the custom tile provider
VITE_MAP_TILE_ATTRIBUTION=
# Optional: URL style.json векторного стиля (Mapbox/MapTiler); приоритетнее VITE_MAP_TILE_URL
VITE_MAP_STYLE_URL=
# Optional: URL тёмного векторного стиля для тёмной темы; если пусто, используется VITE_MAP_STYLE_URL
VITE_MAP_STYLE_URL_DARK=
# Public browser key for local MapTiler styles; restrict it to your app's domains.
VITE_MAPTILER_API_KEY=
