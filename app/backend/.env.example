APP_NAME=Map Points API
APP_ENV=development
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/map_points

# Session authentication
SESSION_COOKIE_NAME=moderator_session
SESSION_IDLE_TIMEOUT_SECONDS=86400
# Keep false for local HTTP development; set true behind HTTPS in production.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

# Comma-separated frontend origins. Do not use * with credentials.
CORS_ORIGINS=http://localhost:5173
